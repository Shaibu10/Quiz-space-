{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["admin", "user"] },
        "status": { "type": "string", "enum": ["active", "deactivated"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName"]
    },
    "Score": {
      "title": "Score",
      "description": "Quiz score record",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "quizId": { "type": "string" },
        "quizTitle": { "type": "string" },
        "category": { "type": "string" },
        "score": { "type": "integer" },
        "totalQuestions": { "type": "integer" },
        "accuracy": { "type": "number" },
        "timeTaken": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "userAnswers": { "type": "array" },
        "questions": { "type": "array" }
      },
      "required": ["uid", "quizId", "score", "totalQuestions", "createdAt"]
    },
    "Category": {
      "title": "Category",
      "description": "Quiz category",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "requiresAccessCode": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name"]
    },
    "Quiz": {
      "title": "Quiz",
      "description": "Quiz document",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "timeLimit": { "type": "integer" },
        "questions": { "type": "array" },
        "isActive": { "type": "boolean" },
        "accessCode": { "type": "string" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "questions"]
    },
    "Settings": {
      "title": "Settings",
      "description": "Global application settings",
      "type": "object",
      "properties": {
        "allowAccountCreation": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "firestore": {
    "/settings/{settingId}": {
      "schema": "Settings",
      "description": "Global settings documents"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile documents"
    },
    "/scores/{scoreId}": {
      "schema": "Score",
      "description": "Quiz score records for leaderboard"
    },
    "/quizzes/{quizId}": {
      "schema": "Quiz",
      "description": "Quiz documents"
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Quiz categories"
    }
  }
}
